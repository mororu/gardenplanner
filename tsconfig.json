{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true
	}
	// Pfad-Aliasse stehen in svelte.config.js, nicht hier.
	// moduleResolution, module, target, include und exclude kommen bereits aus
	// .svelte-kit/tsconfig.json und werden hier absichtlich nicht überschrieben.
}
