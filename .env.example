# Vorlage für die Umgebungsvariablen.
# Lokal nach .env kopieren, auf dem Server nach .env auf der Maschine anlegen.
# Es stehen bewusst keine Werte drin: DATABASE_PATH und SESSION_SECRET haben
# keinen Vorgabewert, sondern werfen beim Modulladen, wenn sie fehlen.

# Pfad zur SQLite-Datei; lokal etwa ./data/dev.sqlite, im Container /data/db.sqlite.
DATABASE_PATH=

# Geheimnis, mit dem das Sitzungs-Cookie signiert wird; 32 Byte Zufall, erzeugt mit openssl rand -base64 32.
SESSION_SECRET=

# Vollständige öffentliche Herkunft der Anwendung, etwa https://garten.example.ch — ohne diesen Wert weist adapter-node hinter nginx jeden form-action-POST als CSRF-Verstoss ab.
ORIGIN=

# Port, auf dem der Node-Server hört; im Container 3000, der Vite-Dev-Server nutzt unabhängig davon 5173.
PORT=
